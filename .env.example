# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# NEXORA Supabase migration switches. Keep false until the matching domain passes QA.
VITE_NEXORA_SUPABASE_SHADOW_READS=false
VITE_NEXORA_SUPABASE_PLAYER_READS=false
VITE_NEXORA_SUPABASE_TRANSFERS=false
VITE_NEXORA_SUPABASE_DAILY_STIPEND=false
VITE_NEXORA_SUPABASE_SKILLS=false
VITE_NEXORA_SUPABASE_MARKET=false
VITE_NEXORA_SUPABASE_MISSIONS=false
VITE_NEXORA_SUPABASE_CONTRACTS=false
VITE_NEXORA_SUPABASE_PROPERTIES=false
VITE_NEXORA_SUPABASE_MANUFACTURING=false
VITE_NEXORA_SUPABASE_PROFILE=false
VITE_NEXORA_SUPABASE_ACCOUNT=false
VITE_NEXORA_SUPABASE_COMPANIES=false
VITE_NEXORA_SUPABASE_ORG_TREASURY=false
VITE_NEXORA_SUPABASE_ORGANIZATIONS=false
VITE_NEXORA_SUPABASE_COMPANY_AUCTIONS=false
VITE_NEXORA_SUPABASE_SOCIAL=false
VITE_NEXORA_SUPABASE_ACHIEVEMENTS=false
